#include "corne.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
	col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 14  GPIO_ACTIVE_HIGH>
        , <&pro_micro 15  GPIO_ACTIVE_HIGH>
        , <&pro_micro 18  GPIO_ACTIVE_HIGH>
        , <&pro_micro 19  GPIO_ACTIVE_HIGH>
        , <&pro_micro 20  GPIO_ACTIVE_HIGH>
        , <&pro_micro 21  GPIO_ACTIVE_HIGH>
        ;
};
/ {
    chosen {
      zmk,battery = &vbatt;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };
};

&pro_micro_i2c {
    status = "okay";
    clock-frequency = <400000>;

    tps43: iqs5xx@74 {
        status = "okay";
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;

        /* RDY = CS header = D1 = P0.06 */
        rdy-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        one-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        tap-drag;
        tap-drag-timeout-ms = <300>;
        two-finger-tap;

        scroll;
        natural-scroll-y;
        natural-scroll-x;
        switch-xy;

        /* Boost precise motion without changing fast swipes. */
        low-speed-gain-percent = <220>;
        low-speed-threshold = <6>;

        three-finger-swipe;
        three-finger-swipe-invert-x;
        three-finger-swipe-threshold-percent = <18>;

        /* Continue the cursor only while a driver-owned drag is active. */
        edge-motion;
        edge-motion-margin-percent = <6>;
        edge-motion-delay-ms = <120>;
        edge-motion-interval-ms = <16>;
        edge-motion-ramp-ms = <800>;
        edge-motion-min-step = <1>;
        edge-motion-max-step = <8>;
    };
};

&tps43_split {
    device = <&tps43>;
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
};
